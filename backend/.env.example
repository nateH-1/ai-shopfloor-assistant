# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required for now: OpenAI API key, used ONLY for document/question embeddings.
# Answers, follow-up rewriting and the off-topic check run on local Ollama.
OPENAI_API_KEY=sk-...

# Optional: Ollama model and server (defaults: qwen2.5:7b, http://localhost:11434)
# Install the model first: ollama pull qwen2.5:7b
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: Flask secret key for session signing
# FLASK_SECRET_KEY=change-me-in-production

# Speech recognition runs locally and does not use OPENAI_API_KEY.
# Download the model once with: python backend/prepare_stt.py
# Defaults: repository-root .models/whisper-base.en, CPU int8, English, 120 seconds.
# STT_MODEL_PATH=C:/absolute/path/to/whisper-base.en
# STT_DEVICE=cpu
# STT_COMPUTE_TYPE=int8
# STT_LANGUAGE=en
# STT_MAX_SECONDS=120

