# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Optional: set only when selecting OpenAI for chat with LLM_PROVIDER=openai.
# Embeddings use Ollama's bge-m3 model and do not require an OpenAI API key.
# OPENAI_API_KEY=sk-...

# Optional answer/guard/rewrite provider: openai or ollama.
# Both local startup and Docker Compose default to ollama.
# LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini

# Optional: Ollama model and server (defaults: qwen2.5:7b, http://localhost:11434)
# Install the model first: ollama pull qwen2.5:7b
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434
# In Docker, localhost is the container. For the school server use its LAN URL,
# for example http://192.168.1.50:11434; for the Docker Desktop host use
# http://host.docker.internal:11434 (Compose's default).

# Optional: Flask secret key for session signing
# FLASK_SECRET_KEY=change-me-in-production

# Optional: How many seconds before a session expires (default is 8 hours = 28800 seconds)
#AUTH_SESSION_TTL_SECONDS="7200"

# Required: set true for using HTTPS
#SESSION_COOKIE_SECURE="true"
# Speech recognition runs locally and does not use OPENAI_API_KEY.
# Download the model once with: python backend/prepare_stt.py
# Defaults: repository-root .models/whisper-base.en, CPU int8, English, 120 seconds.
# STT_MODEL_PATH=C:/absolute/path/to/whisper-base.en
# STT_DEVICE=cpu
# STT_COMPUTE_TYPE=int8
# STT_LANGUAGE=en
# STT_MAX_SECONDS=120

