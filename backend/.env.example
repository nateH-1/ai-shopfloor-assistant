# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: OpenAI API key (used for embeddings + chat completion)
OPENAI_API_KEY=sk-...

# Optional: Override the model (default: gpt-3.5-turbo)
# OPENAI_MODEL=gpt-4o

# Optional: answer model provider: openai (default, fast) or ollama (local, slow on CPU)
# LLM_PROVIDER=ollama
# Optional: provider for the off-topic check (defaults to LLM_PROVIDER).
# Keeping it on openai avoids an extra slow local call per message.
# GUARD_LLM_PROVIDER=openai
# Optional: Ollama model and server (defaults: gemma3:4b, http://localhost:11434)
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_BASE_URL=http://localhost:11434
# Note: embeddings always use OpenAI, so OPENAI_API_KEY is still required.

# Optional: Flask secret key for session signing
# FLASK_SECRET_KEY=change-me-in-production

