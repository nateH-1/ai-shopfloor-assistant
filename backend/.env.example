# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: OpenAI API key (used for embeddings + chat completion)
OPENAI_API_KEY=sk-...

# Optional: Override the model (default: gpt-3.5-turbo)
# OPENAI_MODEL=gpt-4o

# Optional: Flask secret key for session signing
# FLASK_SECRET_KEY=change-me-in-production

# Speech recognition runs locally and does not use OPENAI_API_KEY.
# Download the model once with: python backend/prepare_stt.py
# Defaults: repository-root .models/whisper-base.en, CPU int8, English, 120 seconds.
# STT_MODEL_PATH=C:/absolute/path/to/whisper-base.en
# STT_DEVICE=cpu
# STT_COMPUTE_TYPE=int8
# STT_LANGUAGE=en
# STT_MAX_SECONDS=120

